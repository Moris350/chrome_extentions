{
  "manifest_version": 3,
  "name": "SwiftReply AI",
  "version": "1.0.0",
  "description": "AI-powered email replies in Gmail.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://mail.google.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "css": ["src/content/content.css"],
      "js": ["src/shared/license.js", "src/content/content.js"]
    }
  ]
}
